# Keep endpoints and services in matching order. Put the lower-weight validator
# first so bounded recovery restarts it before the quorum-critical validator.
SHELL_WATCHDOG_ENDPOINTS=http://127.0.0.1:9091,http://127.0.0.1:9090
SHELL_WATCHDOG_SERVICES=shell-node2.service,shell-node1.service

# With the one-minute timer, 15 failures require about 15 minutes of sustained
# production unavailability before one service is restarted.
SHELL_WATCHDOG_FAILURE_THRESHOLD=15
# A failed/inactive managed service is recovered sooner than an active but
# unready service because it cannot make synchronization progress.
SHELL_WATCHDOG_INACTIVE_FAILURE_THRESHOLD=3

# Optional comma-separated legacy or mutually exclusive units. When explicitly
# configured, active conflicts are stopped before validator health is evaluated.
SHELL_WATCHDOG_CONFLICTING_SERVICES=
SHELL_WATCHDOG_STATE_DIR=/var/lib/shell-chain/watchdog
