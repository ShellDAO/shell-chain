# Copy to /etc/default/shell-node and adjust for each instance.

SHELL_NETWORK=testnet
SHELL_CHAIN_ID=10
SHELL_DATADIR=/mnt/shell-data/data/node2
SHELL_KEYSTORE=/opt/shell/keys/validator.json
SHELL_PASSWORD_FILE=/opt/shell/secrets/v1-pw
# Optional fail-fast guard. Set this to the expected 0x-prefixed Shell validator
# address so startup aborts if the keystore points at a different authority.
SHELL_EXPECTED_AUTHORITY=

# Bind RPC to loopback by default. Override only behind firewall/reverse proxy.
SHELL_RPC_ADDR=127.0.0.1:8545
SHELL_WS_PORT=8546
SHELL_METRICS_ADDR=127.0.0.1:9090
SHELL_RPC_API=eth,net,web3,shell
SHELL_RPC_CORS=https://testnet-rpc.shell.org,https://explorer.shell.org,http://localhost,http://127.0.0.1
SHELL_RPC_RATE_LIMIT=50

SHELL_BLOCK_TIME_MS=2000
SHELL_MAX_IDLE_INTERVAL_SECS=600
SHELL_STATE_CACHE_SIZE_MB=32
SHELL_STORAGE_PROFILE=full
SHELL_NODE_ROLE=validator
SHELL_CONSENSUS_ENGINE=wpoa

# Keep ordinary validators from doing local STARK proof work. Set to true only
# on explicitly sized prover or validator-prover nodes.
SHELL_ENABLE_STARK_AGGREGATION=false

# Local libp2p listen address. Keep RPC addresses separate.
SHELL_P2P_ADDR=0.0.0.0:30303

# Optional comma-separated P2P bootnodes. Multi-validator networks should list
# more than one reachable validator or sentry peer, and validators should point
# at each other to avoid one-way restart recovery.
SHELL_BOOTNODES=
