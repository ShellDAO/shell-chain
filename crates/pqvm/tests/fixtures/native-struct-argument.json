{
  "sources": {
    "Ledger": "pragma solidity ^0.8.35; interface I {function balanceOf(address beneficiary) external view returns(uint256);} contract Ledger {struct Entry {address token; address beneficiary;} mapping(uint256=>Entry) private entries; function set(uint256 id,address token,address beneficiary) external {entries[id]=Entry(token,beneficiary);} function lookup(uint256 id) external view returns(uint256) {return I(entries[id].token).balanceOf(entries[id].beneficiary);} }",
    "SelectingLedger": "pragma solidity ^0.8.35; interface I {function balanceOf(address beneficiary) external view returns(uint256);} contract SelectingLedger {struct Entry {address token; address beneficiary;} mapping(uint256=>Entry) private entries; function set(uint256 id,address token,address beneficiary) external {entries[id]=Entry(token,beneficiary);} uint256 public selections; function select(uint256 id) internal returns(uint256) {selections++; return id;} function lookup(uint256 id) external returns(uint256) {return I(entries[id].token).balanceOf(entries[select(id)].beneficiary);} }",
    "Token": "pragma solidity ^0.8.35; contract Token {mapping(address=>uint256) private balances; error Missing(address beneficiary); function balanceOf(address beneficiary) external view returns(uint256) {if(beneficiary==address(0)) revert Missing(beneficiary);return balances[beneficiary];}}",
    "Writer": "pragma solidity ^0.8.35; contract Writer {fallback() external {assembly {sstore(0,calldataload(4)) mstore(0,99) return(0,32)}}}"
  },
