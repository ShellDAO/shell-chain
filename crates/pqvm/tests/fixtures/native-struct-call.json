{
  "sources": {
    "Ledger": "pragma solidity ^0.8.35; interface I {function ownerOf(uint256 id) external view returns(bytes32);} contract Ledger { struct Entry {address owner;} mapping(uint256=>Entry) private entries; function set(uint256 id,address owner) external {entries[id].owner=owner;} function lookup(uint256 id) external view returns(bytes32) {return I(entries[id].owner).ownerOf(type(uint256).max);} }",
    "SelectingLedger": "pragma solidity ^0.8.35; interface I {function ownerOf(uint256 id) external view returns(bytes32);} contract SelectingLedger { struct Entry {address owner;} mapping(uint256=>Entry) private entries; function set(uint256 id,address owner) external {entries[id].owner=owner;} uint256 public selections; function select(uint256 id) internal returns(uint256) {selections++; return id;} function lookup(uint256 id) external returns(bytes32) {return I(entries[select(id)].owner).ownerOf(type(uint256).max);} function denied(uint256 id) external returns(bytes32) {return I(entries[select(id)].owner).ownerOf(0);} }",
    "Owner": "pragma solidity ^0.8.35; contract Owner {bytes32 public owner; error Missing(uint256 id); function ownerOf(uint256 id) external view returns(bytes32) {if(id!=type(uint256).max) revert Missing(id); return owner;}}",
    "Writer": "pragma solidity ^0.8.35; contract Writer {function ownerOf(uint256 id) external returns(bytes32) {assembly {sstore(0,id)} return bytes32(0);}}"
  },
