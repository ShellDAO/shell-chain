{
  "source": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.30;\ncontract IdentityPaymaster {\n address public allowed;\n function validatePaymasterOp(address sender, bytes calldata callData, uint256 maxGasCost, bytes calldata context) external view returns (bool) {\n  return sender == allowed && maxGasCost <= 300000000000000000 && context.length == 1 && context[0] == 0xab && callData.length > 0;\n }\n}",
